  font-size: 10px;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  color: var(--ink-3);
  text-align: left;
  padding: 12px;
  border-bottom: 2px solid var(--ink-1);
  font-weight: 500;
}
table.breakdown-table thead th.num { text-align: right; }
table.breakdown-table tbody td {
  padding: 14px 12px;
  border-bottom: 1px solid var(--rule);
  vertical-align: middle;
}
table.breakdown-table tbody td.seg-num {
  font-family: 'JetBrains Mono', monospace;
  font-size: 11px;
  color: var(--ink-3);
  width: 36px;
}
table.breakdown-table tbody td.seg-name {
  font-family: 'Fraunces', serif;
  font-size: 17px;
  font-weight: 500;
  color: var(--ink-1);
}
table.breakdown-table tbody td.seg-name .sub {
  font-family: 'JetBrains Mono', monospace;
  font-size: 10px;
  color: var(--ink-3);
  margin-left: 10px;
  letter-spacing: 0.04em;
  text-transform: uppercase;
}
table.breakdown-table tbody td.num {
  text-align: right;
  font-variant-numeric: tabular-nums;
  font-family: 'JetBrains Mono', monospace;
  font-size: 13.5px;
  color: var(--ink-1);
}
