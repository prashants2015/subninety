  color: var(--ink-1);
}
.body-section h3 .zone-tag-inline {
  font-family: 'JetBrains Mono', monospace;
  font-size: 10px;
  font-weight: 500;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  padding: 2px 8px;
  border-radius: 2px;
  margin-left: 10px;
  vertical-align: middle;
}
.body-section p {
