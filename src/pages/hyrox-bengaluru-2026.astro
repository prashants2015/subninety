  font-weight: 500;
}
.ref-label {
  font-family: 'JetBrains Mono', monospace;
  font-size: 10px;
  fill: var(--ink-2);
  font-variant-numeric: tabular-nums;
}
.peak-callout {
  font-family: 'JetBrains Mono', monospace;
  font-size: 10px;
