  .stat { padding: 16px 12px; border-bottom: 1px solid var(--rule); }
  .stat:nth-child(2) { border-right: none; }
  .stat:nth-child(3), .stat:nth-child(4) { border-bottom: none; }
  .chart-frame { padding: 24px 16px 16px; }
  .takeaways { padding: 24px 20px; }
  .takeaways ol { grid-template-columns: 1fr; }
  table.breakdown-table tbody td.seg-name { font-size: 15px; }
  table.breakdown-table tbody td.seg-name .sub { display: block; margin: 4px 0 0 0; }
}
