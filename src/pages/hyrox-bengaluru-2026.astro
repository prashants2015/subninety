  border-radius: 1px;
  border: 1px solid;
  white-space: nowrap;
}
.zone-pill.nd { background: transparent; color: var(--ink-3); border-color: var(--rule); }

.faq {
  margin: 56px auto;
  max-width: 880px;
}
.faq h2 {
  font-family: 'Fraunces', serif;
  font-weight: 500;
  font-size: 36px;
  letter-spacing: -0.02em;
  margin: 0 0 28px;
  color: var(--ink-1);
}
.faq details {
  border-bottom: 1px solid var(--rule);
  padding: 22px 4px;
}
.faq details:first-of-type { border-top: 1px solid var(--rule); }
.faq details summary {
  cursor: pointer;
  font-family: 'Fraunces', serif;
  font-weight: 500;
  font-size: 20px;
  color: var(--ink-1);
  list-style: none;
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 20px;
  letter-spacing: -0.01em;
}
.faq details summary::-webkit-details-marker { display: none; }
.faq details summary::after {
  content: '+';
  font-family: 'Inter Tight', sans-serif;
  font-weight: 300;
  font-size: 28px;
  color: var(--yellow);
  transition: transform 0.2s;
  line-height: 1;
}
.faq details[open] summary::after { content: '−'; }
.faq details p {
  margin: 16px 0 4px;
  color: var(--ink-2);
  font-size: 16px;
  line-height: 1.7;
}

