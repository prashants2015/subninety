  color: var(--ink-3);
  text-transform: uppercase;
  margin-bottom: 24px;
}
.chart-frame p.lede {
  color: var(--ink-2);
  margin: 0 0 28px;
  max-width: 760px;
  font-size: 16px;
}
svg.hyrox-chart { width: 100%; height: auto; display: block; }

