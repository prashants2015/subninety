  margin: 0 0 14px;
  font-size: 17px;
  line-height: 1.7;
}
.body-section p.muted { color: var(--ink-2); }

table.breakdown-table {
  width: 100%;
  border-collapse: collapse;
  font-family: 'Inter Tight', sans-serif;
  font-size: 14.5px;
}
table.breakdown-table thead th {
