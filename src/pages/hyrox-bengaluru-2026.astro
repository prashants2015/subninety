  letter-spacing: 0.12em;
  font-weight: 500;
}
.zone-row-label {
  font-family: 'Fraunces', serif;
  font-size: 17px;
  fill: var(--ink-1);
  font-weight: 500;
}
.zone-row-sub {
  font-family: 'JetBrains Mono', monospace;
  font-size: 10px;
  fill: var(--ink-3);
  letter-spacing: 0.05em;
}
.zone-value {
  font-family: 'JetBrains Mono', monospace;
  font-size: 13px;
  fill: var(--ink-1);
  font-variant-numeric: tabular-nums;
  font-weight: 500;
}
.zone-pct { fill: var(--ink-3); margin-left: 6px; font-weight: 400; }
.seg-axis-label {
  font-family: 'JetBrains Mono', monospace;
