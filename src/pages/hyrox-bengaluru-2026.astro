import TimeInZones from '../components/charts/TimeInZones.astro';
import EffortPerSegment from '../components/charts/EffortPerSegment.astro';
import DriftHalves from '../components/charts/DriftHalves.astro';
import RecoveryTransitions from '../components/charts/RecoveryTransitions.astro';
---
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>What heart rate looks like during a HYROX (a standardised run-plus-functional-fitness race format) race — Bengaluru 2026 data</title>
<meta name="description" content="1,157 heart rate samples from a 2:01:06 HYROX race, broken down by all 16 segments. 92% at threshold+, average 167 bpm. Real Apple Watch data with zone, drift, and recovery analysis.">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght,SOFT,WONK@9..144,400;9..144,500;9..144,700;9..144,900&family=Inter+Tight:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Article",
  "headline": "What heart rate looks like during a HYROX race: 1,157 data points from Bengaluru 2026",
  "description": "Continuous heart rate trace from a 2:01:06 HYROX race, broken down by all 16 segments. 92% of the race spent at threshold or above, average 167 bpm, peak 189 bpm.",
  "datePublished": "2026-05-15",
  "dateModified": "2026-05-15",
  "author": {
    "@type": "Person",
    "name": "Prashant Singh"
  },
  "publisher": {
    "@type": "Person",
    "name": "Prashant Singh"
  },
  "about":[
    {
      "@type": "SportsEvent",
      "name": "HYROX Bengaluru 2026",
      "startDate": "2026-04-12"
    },
    {
      "@type": "Thing",
      "name": "HYROX"
    },
    {
      "@type": "Thing",
      "name": "Heart rate training"
    },
    {
      "@type": "Thing",
      "name": "Hybrid fitness racing"
    }
  ],
  "mainEntity": {
    "@type": "Dataset",
    "name": "HYROX Bengaluru 2026 \u2014 heart rate per segment",
    "description": "Per-segment heart rate stats (average, peak, low, zone) for all 16 segments of a HYROX race.",
    "creator": {
      "@type": "Person",
      "name": "Prashant Singh"
    },
    "measurementTechnique": "Apple Watch optical heart rate sensor, sampled at ~5 second intervals via HealthKit",
    "variableMeasured":[
      "heart rate (bpm)",
      "duration (seconds)",
      "heart rate zone"
    ]
  }
}
</script>
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity":[
    {
      "@type": "Question",
      "name": "What's a typical heart rate during a HYROX race?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "For a competitive sub-2-hour finish, expect to average around 167 bpm and spend 90%+ of the race at threshold or above (Z4 + Z5). In this race, the average was 167 bpm across 2 hours 1 minute, with 92.3% of total time at or above 80% of max heart rate (HR)."
      }
    },
    {
      "@type": "Question",
      "name": "Which HYROX station has the highest heart rate?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "In this race, the running segments produced higher average heart rates than the strength stations. The single highest segment average was Run 3 and Run 7, both at 178 bpm. Among workout stations, Sled Push (170 bpm avg) and Sandbag Lunges (170 bpm avg) were the highest."
      }
    },
    {
      "@type": "Question",
      "name": "Which HYROX station gives the most recovery?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Sled Pull, despite being a heavy strength station, ended with the lowest finishing heart rate at 157 bpm \u2014 the slow, technical nature of pulling the sled the full 50 metres in stages allows HR to come down between efforts. It's a deceptive 'recovery' though: the heart rate jumped 21 bpm into the following Run 4."
      }
    },
    {
      "@type": "Question",
      "name": "How much time do you spend in each heart rate zone during HYROX?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "In this race: Z1 Recovery 0.1%, Z2 Aerobic 0.0%, Z3 Tempo 7.6%, Z4 Threshold 51.7%, Z5 Anaerobic 40.6%. More than 92% of the race was spent at threshold or anaerobic effort \u2014 HYROX is functionally a 2-hour threshold race."
      }
    },
    {
      "@type": "Question",
      "name": "Does heart rate drift during a HYROX race?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes, but unevenly. In this race, the second-half average heart rate was only +0.6 bpm higher than the first half overall \u2014 but when you isolate just the running segments, drift was +4.2 bpm (168.7 \u2192 172.8). Stations stayed nearly flat. Translation: the legs were paying the cumulative cost on the runs."
      }
    },
    {
      "@type": "Question",
      "name": "How is heart rate during the roxzone (the transition time between runs and stations)?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "The roxzone \u2014 the time spent moving between segments \u2014 averaged ~41 seconds per transition in this race (10:12 total across 15 transitions). Heart rate behaviour in transitions was bidirectional: 5 of 6 measured transitions saw HR rise into the next run rather than drop, because the run effort exceeds what the previous station was demanding by the end."
      }
    },
    {
      "@type": "Question",
      "name": "How is this heart rate data collected and processed?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Heart rate was captured on an Apple Watch during a Mixed Cardio workout session, exported as JSON via the Health Auto Export iOS app. 1,157 samples were recorded during the 2:01:06 race window at a median interval of 5 seconds. Segment durations are taken from the official HYROX race results. The 10:12 of total roxzone time is distributed equally as ~41 seconds between each of the 15 segment transitions for charting."
      }
    }
  ]
}
</script>
<style>
:root {
  --bg: #0A0A0B;
  --surface: #14141A;
  --panel: #1A1A22;
  --ink-1: #F5F5EE;
  --ink-2: #A0A09A;
  --ink-3: #5C5C58;
  --rule: #26262C;
  --yellow: #FFE600;
  --crimson: #E84B5F;
}
* { box-sizing: border-box; }
html, body { margin: 0; padding: 0; background: var(--bg); color: var(--ink-1); }
body {
  font-family: 'Inter Tight', system-ui, sans-serif;
  font-size: 17px;
  line-height: 1.65;
  -webkit-font-smoothing: antialiased;
  font-feature-settings: "ss01" on, "cv11" on;
}
.wrap { max-width: 1240px; margin: 0 auto; padding: 64px 24px 96px; }

.eyebrow {
  font-family: 'JetBrains Mono', monospace;
  font-size: 11px;
  letter-spacing: 0.2em;
  text-transform: uppercase;
  color: var(--ink-3);
  margin-bottom: 16px;
}
.eyebrow .dash { color: var(--yellow); margin: 0 10px; }

h1.title {
  font-family: 'Fraunces', serif;
  font-weight: 500;
  font-size: clamp(36px, 5.6vw, 60px);
  line-height: 1.02;
  letter-spacing: -0.025em;
  margin: 0 0 22px;
  color: var(--ink-1);
  font-variation-settings: "SOFT" 50, "WONK" 0;
}
h1 em {
  font-style: italic;
  font-variation-settings: "SOFT" 100, "WONK" 1;
  color: var(--yellow);
  font-weight: 400;
}

.standfirst {
  font-family: 'Fraunces', serif;
  font-weight: 400;
  font-size: clamp(19px, 1.6vw, 22px);
  line-height: 1.45;
  color: var(--ink-2);
  max-width: 760px;
  margin: 0 0 56px;
  font-variation-settings: "SOFT" 100, "opsz" 32;
}

.takeaways {
  background: var(--surface);
  border: 1px solid var(--rule);
  padding: 32px 36px;
  margin: 0 0 56px;
}
.takeaways h2 {
  font-family: 'JetBrains Mono', monospace;
  font-size: 11px;
  letter-spacing: 0.2em;
  text-transform: uppercase;
  color: var(--yellow);
  margin: 0 0 22px;
  font-weight: 500;
}
.takeaways ol {
  list-style: none;
  padding: 0;
  margin: 0;
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(380px, 1fr));
  gap: 0;
}
.takeaways li {
  padding: 18px 24px 18px 20px;
  border-left: 2px solid var(--yellow);
  margin: 0 0 4px;
  background: transparent;
  font-size: 15.5px;
  line-height: 1.55;
  color: var(--ink-1);
}
.takeaways li .n {
  font-family: 'JetBrains Mono', monospace;
  color: var(--yellow);
  font-size: 11px;
  letter-spacing: 0.1em;
  display: block;
  margin-bottom: 4px;
  font-weight: 500;
}
.takeaways li strong { color: var(--ink-1); font-weight: 600; }

.byline {
  display: flex; gap: 28px; flex-wrap: wrap;
  font-family: 'JetBrains Mono', monospace;
  font-size: 11.5px; color: var(--ink-3);
  border-top: 1px solid var(--rule);
  border-bottom: 1px solid var(--rule);
  padding: 16px 0;
  margin-bottom: 44px;
}
.byline strong { color: var(--ink-1); font-weight: 500; }

.stats-row {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 0;
  margin: 0 0 44px;
  border-top: 2px solid var(--ink-1);
  border-bottom: 1px solid var(--rule);
}
.stat {
  padding: 20px 24px 20px 0;
  border-right: 1px solid var(--rule);
}
.stat:last-child { border-right: none; }
.stat .num {
  font-family: 'Fraunces', serif;
  font-weight: 500;
  font-size: 46px;
  line-height: 1;
  letter-spacing: -0.025em;
  display: block;
  font-variant-numeric: tabular-nums;
  color: var(--ink-1);
}
.stat .num .unit { font-size: 16px; color: var(--ink-3); font-weight: 400; margin-left: 4px; }
.stat .lbl {
  font-family: 'JetBrains Mono', monospace;
  font-size: 10px;
  letter-spacing: 0.18em;
  text-transform: uppercase;
  color: var(--ink-3);
  margin-top: 10px;
  display: block;
}
.stat.accent .num { color: var(--yellow); }

section { margin-bottom: 56px; }
.chart-frame {
  background: var(--surface);
  border: 1px solid var(--rule);
