  font-size: 14.5px;
  color: var(--ink-2);
  max-width: 880px;
}
.method h3 {
  font-family: 'JetBrains Mono', monospace;
  font-size: 11px;
  letter-spacing: 0.18em;
  text-transform: uppercase;
  margin: 0 0 12px;
  color: var(--ink-1);
  font-weight: 500;
}
.method p { margin: 0 0 10px; }
.method p:last-child { margin-bottom: 0; }

.tooltip {
  position: fixed;
  background: var(--ink-1);
  color: var(--bg);
  padding: 14px 16px;
  border-radius: 1px;
  font-size: 12px;
  font-family: 'JetBrains Mono', monospace;
  pointer-events: none;
  opacity: 0;
  transition: opacity 0.12s;
  z-index: 100;
  min-width: 220px;
  box-shadow: 0 12px 32px rgba(0,0,0,0.4);
}
.tooltip strong {
  font-family: 'Fraunces', serif;
  font-size: 17px;
  font-weight: 600;
  display: block;
  margin-bottom: 8px;
  letter-spacing: -0.01em;
}
.tooltip .row { display: flex; justify-content: space-between; padding: 2px 0; }
.tooltip .row span:first-child { color: var(--ink-3); }
.tooltip .row span:last-child { font-variant-numeric: tabular-nums; color: var(--bg); font-weight: 500; }

