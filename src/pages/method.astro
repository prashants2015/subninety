  width: 10px;
  height: 10px;
  margin-right: 8px;
  vertical-align: middle;
  border-radius: 2px;
}

.caveat {
  background: var(--surface);
  border-left: 3px solid var(--yellow);
  padding: 20px 24px;
  margin: 16px 0;
}
.caveat p { margin: 0; font-size: 15.5px; line-height: 1.6; color: var(--ink-2); }
.caveat p strong { color: var(--ink-1); font-weight: 500; }

.spec-list {
  font-family: 'JetBrains Mono', monospace;
  font-size: 13.5px;
  line-height: 1.85;
  color: var(--ink-2);
