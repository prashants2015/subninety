.toc ol {
  list-style: none;
  padding: 0;
  margin: 0;
  counter-reset: toc;
  font-family: 'Fraunces', serif;
  font-size: 16px;
  line-height: 1.85;
  font-variant-numeric: tabular-nums;
}
.toc ol li {
  counter-increment: toc;
}
.toc ol li::before {
  content: counter(toc, decimal-leading-zero) "  ";
