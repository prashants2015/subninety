<style>
:root {
  --bg: #0A0A0B;
  --surface: #14141A;
  --panel: #1A1A22;
  --ink-1: #F5F5EE;
  --ink-2: #A0A09A;
  --ink-3: #5C5C58;
  --rule: #26262C;
  --yellow: #FFE600;
}
* { box-sizing: border-box; }
html, body { margin: 0; padding: 0; background: var(--bg); color: var(--ink-1); }
body {
  font-family: 'Inter Tight', system-ui, sans-serif;
  font-size: 17px;
  line-height: 1.65;
  -webkit-font-smoothing: antialiased;
  font-feature-settings: "ss01" on, "cv11" on;
}
a { color: inherit; }

.wrap { max-width: 1240px; margin: 0 auto; padding: 80px 24px 96px; }

/* Site header (matches homepage + about) */
.site-header {
  border-bottom: 1px solid var(--rule);
  padding-bottom: 24px;
  margin-bottom: 96px;
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 24px;
  flex-wrap: wrap;
}
.wordmark {
  font-family: 'Fraunces', serif;
  font-size: 28px;
  font-weight: 500;
  letter-spacing: -0.01em;
  font-variation-settings: "SOFT" 50;
  color: var(--ink-1);
  text-decoration: none;
}
.wordmark .dot { color: var(--yellow); }
.tagline {
  font-family: 'JetBrains Mono', monospace;
  font-size: 11px;
  letter-spacing: 0.18em;
  text-transform: uppercase;
  color: var(--ink-3);
}

.method-content { max-width: 760px; margin: 0 auto; }

.eyebrow {
  font-family: 'JetBrains Mono', monospace;
  font-size: 11px;
  letter-spacing: 0.2em;
  text-transform: uppercase;
  color: var(--ink-3);
  margin-bottom: 16px;
}

h1.title {
  font-family: 'Fraunces', serif;
  font-weight: 500;
  font-size: clamp(40px, 5.2vw, 60px);
  line-height: 1.02;
  letter-spacing: -0.025em;
  margin: 0 0 22px;
  color: var(--ink-1);
  font-variation-settings: "SOFT" 50;
}

.standfirst {
