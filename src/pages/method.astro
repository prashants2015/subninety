  border-left: 2px solid var(--yellow);
  padding: 20px 28px;
  margin-bottom: 64px;
}
.toc h2 {
  font-family: 'JetBrains Mono', monospace;
  font-size: 10px;
  letter-spacing: 0.2em;
  text-transform: uppercase;
  color: var(--ink-3);
  font-weight: 500;
  margin: 0 0 12px;
