  font-weight: 400;
  font-size: clamp(20px, 1.7vw, 24px);
  line-height: 1.45;
  color: var(--ink-2);
  margin: 0 0 56px;
  font-variation-settings: "SOFT" 100, "opsz" 32;
}

.toc {
